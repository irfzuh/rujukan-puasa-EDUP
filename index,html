    <!-- ==================== SKRIP LOGIK RANGKA & SFX ==================== -->
    <script>
        let sfxEnabled = true;

        // Enjin Kesan Bunyi (Tone.js)
        async function playSFX(type) {
            if (!sfxEnabled || typeof Tone === 'undefined') return;
            try {
                if (Tone.context.state !== 'running') {
                    await Tone.start();
                }
                const now = Tone.now();

                if (type === 'tab') {
                    const synth = new Tone.Synth({
                        oscillator: { type: 'sine' },
                        envelope: { attack: 0.005, decay: 0.12, sustain: 0, release: 0.1 }
                    }).toDestination();
                    synth.volume.value = -10;
                    synth.triggerAttackRelease('E5', '16n', now);
                    synth.triggerAttackRelease('A5', '16n', now + 0.06);
                } else if (type === 'paper') {
                    const noise = new Tone.NoiseSynth({
                        noise: { type: 'pink' },
                        envelope: { attack: 0.01, decay: 0.14, sustain: 0, release: 0.05 }
                    }).toDestination();
                    noise.volume.value = -16;
                    noise.triggerAttackRelease('16n', now);
                } else if (type === 'click') {
                    const synth = new Tone.MembraneSynth().toDestination();
                    synth.volume.value = -14;
                    synth.triggerAttackRelease('C4', '32n', now);
                }
            } catch (e) {
                // Abaikan jika audio disekat pelayar
            }
        }

        function toggleSFX() {
            sfxEnabled = !sfxEnabled;
            const btn = document.getElementById('sfxToggleBtn');
            btn.textContent = sfxEnabled ? '🔊' : '🔇';
            if (sfxEnabled) playSFX('click');
        }

        // Penukaran Tab Antara DSKP & Rujukan
        function switchTab(tab) {
            playSFX('tab');
            const secDskp = document.getElementById('sectionDskp');
            const secRujukan = document.getElementById('sectionRujukan');
            const btnDskp = document.getElementById('tabDskp');
            const btnRujukan = document.getElementById('tabRujukan');

            if (tab === 'dskp') {
                secDskp.classList.remove('hidden');
                secRujukan.classList.add('hidden');
                btnDskp.className = 'px-4 py-2 rounded-xl text-xs sm:text-sm font-extrabold transition cursor-pointer bg-diorama-dark text-white shadow';
                btnRujukan.className = 'px-4 py-2 rounded-xl text-xs sm:text-sm font-extrabold transition cursor-pointer text-diorama-deepest hover:bg-white/60';
            } else {
                secRujukan.classList.remove('hidden');
                secDskp.classList.add('hidden');
                btnRujukan.className = 'px-4 py-2 rounded-xl text-xs sm:text-sm font-extrabold transition cursor-pointer bg-diorama-dark text-white shadow';
                btnDskp.className = 'px-4 py-2 rounded-xl text-xs sm:text-sm font-extrabold transition cursor-pointer text-diorama-deepest hover:bg-white/60';
            }
        }

        // Kawalan Modal Zum Penuh
        function openLightbox(containerId, titleText) {
            playSFX('paper');
            const sourceEl = document.getElementById(containerId);
            const targetBox = document.getElementById('lightboxContent');
            document.getElementById('lightboxTitle').textContent = titleText;
            targetBox.innerHTML = sourceEl.innerHTML;
            const clonedImg = targetBox.querySelector('img');
            if (clonedImg) {
                clonedImg.classList.remove('max-h-[65vh]', 'max-h-[75vh]');
                clonedImg.classList.add('max-h-[78vh]');
            }
            document.getElementById('lightboxModal').classList.remove('hidden');
        }

        function closeLightbox(event) {
            if (!event || event.target.id === 'lightboxModal') {
                playSFX('click');
                document.getElementById('lightboxModal').classList.add('hidden');
            }
        }
    </script>
